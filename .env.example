# Copia a variables de entorno en Railway/Fly/Cloud Run.
# El worker NO necesita ninguna key de Supabase: habla con dos Edge Functions
# (worker-next / worker-result) usando un secreto compartido.

# Base de las Edge Functions (Lovable Cloud → Cloud → Edge functions → verás la URL).
# Formato: https://TU-PROYECTO.supabase.co/functions/v1
WORKER_API_URL=https://TU-PROYECTO.supabase.co/functions/v1

# El mismo valor que agregas en Lovable Cloud → Secrets → WORKER_SECRET
WORKER_SECRET=pon-aqui-un-secreto-largo-y-aleatorio

# opcional
POLL_INTERVAL_SECONDS=5

# Fase 2 (opcional) — identificación por huella acústica (Chromaprint + AcoustID).
# Consigue una API key gratis en https://acoustid.org/new-application
# Si la dejas vacía, el worker sigue funcionando igual pero sin identificar canciones sin tags.
ACOUSTID_API_KEY=
